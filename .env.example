# 复制为 .env 后填入真实 key（.env 已被 .gitignore 忽略，不要提交）
# 阿里云百炼（DashScope）OpenAI 兼容接入
LEXFLOW_API_KEY=sk-替换为你的key
LEXFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LEXFLOW_MODEL=deepseek-v4.1-flash

# 百炼 deepseek-v4.1-flash 原价（元/百万 token）：闲时输入 1 / 输出 4，忙时输入 2 / 输出 8。
# 这里按忙时上限填写，避免低估；实际账单以百炼控制台为准。
LEXFLOW_PRICE_INPUT_PER_M=2
LEXFLOW_PRICE_OUTPUT_PER_M=8

# 可选：强制使用 cpu 跑本地 embedding / reranker
# LEXFLOW_DEVICE=cpu
